[Unit]
Description=Portfolio and Backoffice
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portfolio
Group=portfolio
WorkingDirectory=/opt/portfolio
EnvironmentFile=/opt/portfolio/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node --import tsx server/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/portfolio /var/backups/portfolio

[Install]
WantedBy=multi-user.target
